rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/games/{gameId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && gameId.size() <= 120
        && request.resource.data.keys().hasOnly(['player','answers','appeals','savedAt'])
        && request.resource.data.player is string
        && request.resource.data.answers is map
        && request.resource.data.appeals is map;
    }
  }
}
